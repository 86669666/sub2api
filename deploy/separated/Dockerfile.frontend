# syntax=docker/dockerfile:1.7
# Panel image: static frontend plus nginx same-origin proxy for /api/v1.

ARG NODE_IMAGE=node:24-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine
ARG NPM_CONFIG_REGISTRY=

FROM --platform=${BUILDPLATFORM} ${NODE_IMAGE} AS frontend-builder
ARG NPM_CONFIG_REGISTRY
ARG VITE_API_BASE_URL=/api/v1

WORKDIR /app/frontend

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN --mount=type=cache,id=sub2api-separated-pnpm,target=/root/.local/share/pnpm/store \
    if [ -n "${NPM_CONFIG_REGISTRY}" ]; then pnpm config set registry "${NPM_CONFIG_REGISTRY}"; fi && \
    pnpm install --frozen-lockfile --prefer-offline

COPY frontend/ ./
# LegalDocumentView.vue imports ../../../../docs/legal/*.md?raw.
COPY docs/legal/ /app/docs/legal/

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
# vite.config.ts defaults outDir to ../backend/internal/web/dist; override it.
RUN pnpm run build -- --outDir /out/dist --emptyOutDir

FROM ${NGINX_IMAGE}

COPY --from=frontend-builder /out/dist /usr/share/nginx/html
COPY deploy/separated/panel.nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/separated/proxy_common.conf /etc/nginx/proxy_common.conf
COPY deploy/separated/admin-allowlist.conf /etc/nginx/admin-allowlist.conf

EXPOSE 80
