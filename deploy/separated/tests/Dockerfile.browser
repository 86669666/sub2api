ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble
FROM ${PLAYWRIGHT_IMAGE}
WORKDIR /work
RUN npm install --ignore-scripts --no-audit --no-fund --save-exact playwright@1.56.1
COPY deploy/separated/tests/browser-probes.mjs /work/browser-probes.mjs
COPY deploy/separated/tests/visual-probes.mjs deploy/separated/tests/visual-contract.mjs /work/
CMD ["node", "/work/browser-probes.mjs"]
