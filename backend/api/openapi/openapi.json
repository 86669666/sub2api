                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "FORBIDDEN"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "423": {
            "description": "Administrator has not acknowledged the current compliance version.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "ADMIN_COMPLIANCE_ACK_REQUIRED"
                    },
                    "message": {
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        },
                        "document_path_zh": {
                          "type": "string"
                        },
                        "document_path_en": {
                          "type": "string"
                        },
                        "document_url_zh": {
