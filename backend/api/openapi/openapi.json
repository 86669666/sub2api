    "/api/v1/admin/system/version": {
      "get": {
        "operationId": "getAdminSystemVersion",
        "summary": "Current version for the administrator frontend.",
        "description": "No path/query parameters or request body are consumed; force is not a parameter of this endpoint. Requires admin JWT or x-api-key. An upgrade-shaped request (Upgrade: websocket and Connection containing upgrade) may carry jwt.<token> in Sec-WebSocket-Protocol; this middleware alternative has precedence over x-api-key, which has precedence over Authorization. Invalid higher-priority credentials never fall back. The handler still returns ordinary JSON 200, never 101/SSE/WebSocket frames. Active JWT user, token version, optional session binding and admin role are checked; API key maps to GetFirstAdmin. Compliance acknowledgement is required and configured panel limits may apply. Update lookup failures fall back to current version, not an invented handler error.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AdminAPIKey": []
          },
          {
            "AdminUpgradeJWT": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current version; updater warnings and other release fields are not returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "const": 0
                    },
                    "message": {
                      "type": "string",
                      "const": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing/malformed credentials, invalid admin key or token, expired token, missing/inactive user, revoked token or session binding mismatch. Codes: UNAUTHORIZED, INVALID_ADMIN_KEY, INVALID_TOKEN, TOKEN_EXPIRED, USER_NOT_FOUND, USER_INACTIVE, TOKEN_REVOKED, SESSION_BINDING_MISMATCH.",
            "content": {
              "application/json": {
                "schema": {
